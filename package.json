{
  "name": "eta",
  "version": "0.1.105",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config",
    "typecheck": "tsc --noEmit",
    "sync:repos": "node scripts/sync-reference-repos.ts",
    "sync:agent": "node scripts/sync-agent.ts",
    "build:desktop": "vp run @eta/desktop#build",
    "dev:website": "vp run @eta/website#dev",
    "build:website": "vp run @eta/website#build",
    "dev:mobile": "vp run eta-mobile#dev",
    "build:mobile": "vp run eta-mobile#build",
    "package:mac": "vp run --no-cache @eta/desktop#package:mac",
    "package:win": "vp run --no-cache @eta/desktop#package:win",
    "dev": "vp run --no-cache @eta/desktop#build:electron && vp run @eta/desktop#dev"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
