{
  "name": "@effect/atom-solid",
  "version": "4.0.0-rc.117",
  "description": "SolidJS bindings for the Effect Atom modules",
  "keywords": [
    "database",
    "solid",
    "typescript"
  ],
  "homepage": "https://effect.website",
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/atom/solid"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "effect": "workspace:^",
    "jsdom": "~30.0.1",
    "solid-js": "^1.9.15"
  },
  "peerDependencies": {
    "effect": "workspace:^",
    "solid-js": ">=1.9.14 <2.0.0"
  },
  "tags": [
    "typescript",
    "solid",
    "database"
  ]
}
