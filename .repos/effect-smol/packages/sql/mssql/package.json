{
  "name": "@effect/sql-mssql",
  "version": "4.0.0-rc.117",
  "description": "A Microsoft SQL Server toolkit for Effect",
  "keywords": [
    "database",
    "sql",
    "typescript"
  ],
  "homepage": "https://effect.website",
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/sql/mssql"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "tedious": "^20.0.0"
  },
  "devDependencies": {
    "@testcontainers/mssqlserver": "^12.1.0",
    "effect": "workspace:^"
  },
  "peerDependencies": {
    "effect": "workspace:^"
  },
  "tags": [
    "typescript",
    "sql",
    "database"
  ]
}
