{
  "name": "@effect/doctest",
  "version": "4.0.0-rc.117",
  "description": "Runs TypeScript documentation examples as Vitest tests",
  "homepage": "https://effect.website",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/tools/doctest"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./index": null,
    "./internal/*": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./index": null,
      "./internal/*": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "rolldown": "^1.2.9"
  },
  "devDependencies": {
    "@effect/vitest": "workspace:^",
    "@types/node": "^26.6.2",
    "effect": "workspace:^",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "effect": "workspace:^",
    "vite": ">=8.1.5 <9.0.0",
    "vitest": ">=5.0.0 <6.0.0"
  }
}
