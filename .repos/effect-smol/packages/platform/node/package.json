{
  "name": "@effect/platform-node",
  "version": "4.0.0-rc.117",
  "description": "Platform specific implementations for the Node.js runtime",
  "keywords": [
    "algebraic-data-types",
    "functional-programming",
    "node",
    "typescript"
  ],
  "homepage": "https://effect.website",
  "bugs": {
    "url": "https://github.com/Effect-TS/effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/effect.git",
    "directory": "packages/platform/node"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node-shared": "workspace:^",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^26.6.2",
    "effect": "workspace:^",
    "redis": "^6.2.1"
  },
  "peerDependencies": {
    "effect": "workspace:^",
    "redis": ">=5.0.0 <7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "tags": [
    "node",
    "typescript",
    "algebraic-data-types",
    "functional-programming"
  ]
}
