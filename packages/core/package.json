{
  "name": "@eta/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/build-sandbox.mjs dist/sandbox && node ../../scripts/build-codemode.mjs dist/sandbox",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@cf-wasm/photon": "catalog:",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@eta/agent": "workspace:*",
    "@eta/computer-use": "workspace:*",
    "effect": "catalog:",
    "quickjs-wasi": "3.6.2",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
