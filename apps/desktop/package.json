{
  "name": "@eta/desktop",
  "version": "0.1.104",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build:renderer": "vp build --config renderer/vite.config.ts",
    "build:electron": "tsc --noEmit && vp pack && node ../../scripts/build-sandbox.mjs dist/electron && node ../../scripts/build-codemode.mjs dist/electron",
    "build": "vp run build:renderer && vp run build:electron",
    "package:mac": "vp run build && node scripts/prepare-package.mjs && node scripts/verify-package.mjs && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:win": "vp run build && node scripts/prepare-package.mjs && node scripts/verify-package.mjs && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dev": "node scripts/dev-runner.ts",
    "typecheck": "tsc --noEmit",
    "test:packaging": "node --test scripts/signing-config.test.cjs",
    "test": "vp test run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@cf-wasm/photon": "catalog:",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@eta/agent": "workspace:*",
    "@eta/core": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "class-variance-authority": "^0.7.1",
    "effect": "catalog:",
    "electron-updater": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "^0.564.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "catalog:",
    "tailwind-merge": "^3.4.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "electron": "44.4.2",
    "electron-builder": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
