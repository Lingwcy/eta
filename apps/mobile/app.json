{
  "expo": {
    "name": "Eta",
    "icon": "./assets/icon.png",
    "slug": "eta-mobile",
    "scheme": "eta-mobile",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eta.mobile"
    },
    "android": {
      "package": "com.eta.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#171717"
      },
      "permissions": [],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-apk-installer.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 108,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Eta 读取你选择的图片，用于发送给 Bot。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
