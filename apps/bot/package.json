{
  "name": "@eta/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types --import ./src/source-loader.ts ./src/main.ts",
    "build": "tsc --noEmit && vp pack && node ../../scripts/build-sandbox.mjs dist",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "verify-package": "node scripts/verify-package.mjs",
    "verify-container": "node scripts/verify-container.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.2",
    "@eta/agent": "workspace:*",
    "@eta/core": "workspace:*",
    "@hono/node-server": "catalog:",
    "discord.js": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "ws": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
