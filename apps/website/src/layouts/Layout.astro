---
import "@fontsource-variable/manrope";
import "@fontsource/bebas-neue/latin-400.css";
import "@fontsource/space-mono/latin-400.css";
import "../styles/global.css";
import { copy, type Locale } from "../content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
// Set SITE_URL at build time once the production domain is chosen.
const siteUrl = Astro.site;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eta" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    {siteUrl && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL("/social.png", siteUrl).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Eta — Beyond the prompt." />
        <link rel="alternate" hreflang="en" href={new URL("/", siteUrl).href} />
        <link rel="alternate" hreflang="zh-CN" href={new URL("/zh/", siteUrl).href} />
        <link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl).href} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
